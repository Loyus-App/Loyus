{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import"],
  "options": { "typeAware": true },
  "ignorePatterns": ["/*", "!/src/", "!/__mocks__/"],
  "categories": { "correctness": "error" },
  "rules": {
    "eslint/complexity": ["error", { "max": 10 }],
    "eslint/default-case-last": "error",
    "eslint/default-param-last": "error",
    "eslint/eqeqeq": "error",
    "eslint/max-lines": ["error", { "max": 200, "skipBlankLines": true, "skipComments": true }],
    "eslint/max-lines-per-function": [
      "error",
      { "max": 80, "skipBlankLines": true, "skipComments": true }
    ],
    "eslint/no-await-in-loop": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-console": "warn",
    "eslint/no-constructor-return": "error",
    "eslint/no-else-return": "error",
    "eslint/no-empty": "error",
    "eslint/no-empty-function": "error",
    "eslint/no-extra-label": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-lone-blocks": "error",
    "eslint/no-lonely-if": "error",
    "eslint/no-nested-ternary": "error",
    "eslint/no-param-reassign": "error",
    "eslint/no-prototype-builtins": "error",
    "eslint/no-redeclare": "error",
    "eslint/no-regex-spaces": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-sequences": "error",
    "eslint/no-unneeded-ternary": "error",
    "eslint/no-unused-vars": [
      "error",
      { "args": "all", "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }
    ],
    "eslint/no-useless-concat": "error",
    "eslint/no-useless-constructor": "error",
    "eslint/no-var": "error",
    "eslint/no-void": ["error", { "allowAsStatement": true }],
    "eslint/operator-assignment": "error",
    "eslint/prefer-arrow-callback": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-exponentiation-operator": "error",
    "eslint/prefer-regex-literals": "error",
    "eslint/prefer-rest-params": "error",
    "eslint/prefer-template": "error",
    "eslint/require-await": "error",
    "import/namespace": "off",
    "import/no-cycle": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/no-const-enum": "error",
    "react/jsx-fragments": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-literals": "warn",
    "react/jsx-no-useless-fragment": ["error", { "allowExpressions": true }],
    "react/no-array-index-key": "error",
    "react/no-unstable-nested-components": "error",
    "react/rules-of-hooks": "error",
    "react/self-closing-comp": "error",
    "typescript/array-type": ["error", { "default": "array" }],
    "typescript/consistent-type-imports": ["error", { "disallowTypeAnnotations": false }],
    "typescript/dot-notation": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-empty-object-type": ["error", { "allowInterfaces": "with-single-extends" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-misused-spread": ["error", { "allow": [{ "from": "lib", "name": "string" }] }],
    "typescript/no-namespace": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-enum-initializers": "error",
    "typescript/prefer-for-of": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-literal-enum-member": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/new-for-builtins": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-lonely-if": "error",
    "unicorn/no-negated-condition": "error",
    "unicorn/no-useless-switch-case": "error",
    "unicorn/no-useless-undefined": [
      "error",
      { "checkArguments": false, "checkArrowFunctionBody": false }
    ],
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    "unicorn/throw-new-error": "error"
  },
  "overrides": [
    {
      "files": ["**/__tests__/**", "**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}"],
      "rules": {
        "eslint/max-lines": "off",
        "eslint/max-lines-per-function": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": [
        "src/domain/brandCatalog.ts",
        "src/infra/i18n/locales/**",
        "src/ui/brands/brandLogos.ts"
      ],
      "rules": { "eslint/max-lines": "off" }
    },
    {
      "files": [
        "src/app/(tabs)/settings/index.tsx",
        "src/app/card/?id?.tsx",
        "src/app/card/brands.tsx",
        "src/app/card/scan.tsx",
        "src/ui/components/CardForm.tsx"
      ],
      "rules": { "eslint/max-lines": "off" }
    },
    {
      "files": [
        "src/app/card/brands.tsx",
        "src/ui/components/CardForm.tsx",
        "src/ui/components/form/useCardForm.ts",
        "src/widgets/CardsWidget.ios.tsx"
      ],
      "rules": { "eslint/max-lines-per-function": "off" }
    },
    {
      "files": ["**/__mocks__/**"],
      "rules": {
        "eslint/no-empty": "off",
        "eslint/no-empty-function": "off"
      }
    }
  ]
}
