# Publisher-private planning and workflow artifacts — not part of the public repo
.planning/

# Claude Code per-developer settings (permissions, env vars) + runtime locks
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# EAS submit credentials — do not commit; set via CLI or env at submit time
eas.json.local

# Dependencies
node_modules/
# Project is Yarn-managed — block stray npm/pnpm lockfiles (EAS picks the wrong package manager otherwise).
package-lock.json
pnpm-lock.yaml

# Yarn Berry (no zero-installs)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds
ios/
android/

# Environment
.env
.env.local
.env.production

# IDE
.vscode/
.idea/

# OS
.DS_Store
*.pem

# Maestro E2E reports (keep .gitkeep)
.maestro/reports/*.xml
.maestro/reports/*.png

# Coverage
coverage/

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*
