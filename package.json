{
  "name": "loyus",
  "main": "index.ts",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "ios": "npx expo run:ios",
    "android": "npx expo run:android",
    "start": "npx expo start --dev-client",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check",
    "check:fix": "oxlint --fix && oxfmt",
    "typecheck": "npx tsc --noEmit",
    "test": "npx jest --passWithNoTests",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:e2e:studio": "maestro studio",
    "brands:build": "node scripts/build-brands.mjs",
    "icons:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-app-icons.mjs",
    "postinstall": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yaml,yml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "expo": "~58.0.26",
    "expo-alternate-app-icons": "^11.0.0",
    "expo-brightness": "~58.0.3",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "expo-widgets": "~58.0.29",
    "i18next": "^27.2.2",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-reorderable-list": "^0.18.3",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "^3.8.2",
    "react-native-vision-camera": "^5.2.4",
    "react-native-vision-camera-barcode-scanner": "^5.2.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-vision-camera-barcode-scanner"
        ]
      }
    }
  }
}
