{
  "name": "loyus",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "ios": "npx expo run:ios",
    "android": "npx expo run:android",
    "start": "npx expo start --dev-client",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "npx tsc --noEmit",
    "test": "npx jest --passWithNoTests",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:e2e:studio": "maestro studio",
    "postinstall": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yaml,yml}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@kichiyaki/react-native-barcode-generator": "^0.6.7",
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "~58.0.0-preview.7",
    "expo-brightness": "~58.0.0",
    "expo-build-properties": "~58.0.7",
    "expo-clipboard": "~58.0.1",
    "expo-constants": "~58.0.7",
    "expo-crypto": "~58.0.2",
    "expo-file-system": "~58.0.2",
    "expo-font": "~58.0.2",
    "expo-haptics": "~58.0.1",
    "expo-keep-awake": "~58.0.1",
    "expo-linear-gradient": "~58.0.1",
    "expo-linking": "~58.0.7",
    "expo-localization": "~58.0.1",
    "expo-router": "~58.0.8",
    "expo-sharing": "~58.0.10",
    "expo-splash-screen": "~58.0.1",
    "expo-status-bar": "~58.0.1",
    "expo-web-browser": "~58.0.2",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.88.0-rc.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-unistyles": "^3.3.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-barcode-scanner": "^5.2.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@react-native/jest-preset": "0.88.0-rc.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.0",
    "@types/react": "~19.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.3",
    "lint-staged": "^17.6.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-vision-camera-barcode-scanner"
        ]
      }
    }
  }
}
